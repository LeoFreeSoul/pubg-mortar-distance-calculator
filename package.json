{
  "name": "pubg-mortar-calc",
  "version": "1.0.0-zh.4",
  "description": "PUBG 迫击炮测距工具（简体中文版）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {

  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.pubg.mortarcalc.zhcn",
    "productName": "PUBG 迫击炮测距",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "overlay.html",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "PUBG-Mortar-Calc-zh-CN-${version}.exe"
    }
  }
}
